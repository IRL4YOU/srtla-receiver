diff --git a/src/core/SLSFrameStats.cpp b/src/core/SLSFrameStats.cpp
new file mode 100644
index 0000000..c8fa362
--- /dev/null
+++ b/src/core/SLSFrameStats.cpp
@@ -0,0 +1,271 @@
+/**
+ * The MIT License (MIT)
+ *
+ * Copyright (c) 2019-2020 Edward.Wu
+ */
+
+#include "SLSFrameStats.hpp"
+
+#include <algorithm>
+#include <cstring>
+
+#include "SLSTimecode.hpp"
+
+namespace
+{
+constexpr int TS_PACKET_LENGTH = 188;
+constexpr uint8_t TS_SYNC = 0x47;
+constexpr int INVALID_TS_PID = -1;
+constexpr int64_t INVALID_TIMESTAMP = -1;
+constexpr int PAT_PID = 0;
+constexpr uint8_t PSI_TABLE_ID_PAT = 0x00;
+constexpr uint8_t PSI_TABLE_ID_PMT = 0x02;
+constexpr int TS_STREAM_TYPE_H264 = 0x1B;
+constexpr int TS_STREAM_TYPE_HEVC = 0x24;
+constexpr int64_t PTS_WRAP = 1LL << 33;
+constexpr int MIN_INTERVAL_SAMPLES = 8;
+
+int64_t read_pts(const uint8_t *b)
+{
+    int64_t pts = ((int64_t)(b[0] & 0x0E)) << 29;
+    pts |= ((int64_t)b[1]) << 22;
+    pts |= ((int64_t)(b[2] & 0xFE)) << 14;
+    pts |= ((int64_t)b[3]) << 7;
+    pts |= ((int64_t)(b[4] & 0xFE)) >> 1;
+    return pts;
+}
+
+bool psi_section(const uint8_t *payload, int len, uint8_t table_id, const uint8_t *&section, int &section_len)
+{
+    if (len < 1)
+        return false;
+    int offset = 1 + payload[0];
+    if (offset + 8 > len)
+        return false;
+    const uint8_t *candidate = payload + offset;
+    int available = len - offset;
+    if (candidate[0] != table_id)
+        return false;
+    int encoded_len = ((candidate[1] & 0x0F) << 8) | candidate[2];
+    if (encoded_len < 9 || encoded_len + 3 > available)
+        return false;
+    section = candidate;
+    section_len = 3 + encoded_len - 4; // exclude CRC_32
+    return true;
+}
+
+void reset_timing(ts_frame_stats_state *st)
+{
+    st->last_timestamp = INVALID_TIMESTAMP;
+    st->interval_count = 0;
+    st->interval_index = 0;
+    st->nominal_interval = 0;
+}
+
+void parse_pat(const uint8_t *payload, int len, ts_frame_stats_state *st)
+{
+    const uint8_t *section = nullptr;
+    int section_len = 0;
+    if (!psi_section(payload, len, PSI_TABLE_ID_PAT, section, section_len))
+        return;
+
+    for (int pos = 8; pos + 4 <= section_len; pos += 4)
+    {
+        int program_number = (section[pos] << 8) | section[pos + 1];
+        if (program_number == 0)
+            continue;
+        int pmt_pid = ((section[pos + 2] & 0x1F) << 8) | section[pos + 3];
+        if (pmt_pid != st->pmt_pid)
+        {
+            st->pmt_pid = pmt_pid;
+            st->video_pid = INVALID_TS_PID;
+            st->codec = SLS_TC_CODEC_NONE;
+            reset_timing(st);
+        }
+        return;
+    }
+}
+
+void parse_pmt(const uint8_t *payload, int len, ts_frame_stats_state *st)
+{
+    const uint8_t *section = nullptr;
+    int section_len = 0;
+    if (!psi_section(payload, len, PSI_TABLE_ID_PMT, section, section_len) || section_len < 12)
+        return;
+
+    int program_info_len = ((section[10] & 0x0F) << 8) | section[11];
+    int pos = 12 + program_info_len;
+    while (pos + 5 <= section_len)
+    {
+        int stream_type = section[pos];
+        int elementary_pid = ((section[pos + 1] & 0x1F) << 8) | section[pos + 2];
+        int es_info_len = ((section[pos + 3] & 0x0F) << 8) | section[pos + 4];
+        int codec = stream_type == TS_STREAM_TYPE_H264   ? SLS_TC_CODEC_H264
+                    : stream_type == TS_STREAM_TYPE_HEVC ? SLS_TC_CODEC_HEVC
+                                                         : SLS_TC_CODEC_NONE;
+        if (codec != SLS_TC_CODEC_NONE)
+        {
+            if (elementary_pid != st->video_pid || codec != st->codec)
+            {
+                st->video_pid = elementary_pid;
+                st->codec = codec;
+                reset_timing(st);
+            }
+            return;
+        }
+        pos += 5 + es_info_len;
+    }
+}
+
+int64_t wrapped_delta(int64_t current, int64_t previous)
+{
+    int64_t delta = current - previous;
+    if (delta < -(PTS_WRAP / 2))
+        delta += PTS_WRAP;
+    else if (delta > PTS_WRAP / 2)
+        delta -= PTS_WRAP;
+    return delta;
+}
+
+int64_t median_interval(const ts_frame_stats_state *st)
+{
+    int64_t sorted[24];
+    std::memcpy(sorted, st->frame_intervals, (size_t)st->interval_count * sizeof(sorted[0]));
+    std::sort(sorted, sorted + st->interval_count);
+    int middle = st->interval_count / 2;
+    if ((st->interval_count & 1) != 0)
+        return sorted[middle];
+    return (sorted[middle - 1] + sorted[middle]) / 2;
+}
+
+void remember_clean_interval(ts_frame_stats_state *st, int64_t delta)
+{
+    st->frame_intervals[st->interval_index] = delta;
+    st->interval_index = (st->interval_index + 1) % 24;
+    if (st->interval_count < 24)
+        st->interval_count++;
+    if (st->interval_count >= MIN_INTERVAL_SAMPLES)
+        st->nominal_interval = median_interval(st);
+}
+
+void note_frame(ts_frame_stats_state *st, int64_t timestamp)
+{
+    st->observed_frames++;
+    if (timestamp == INVALID_TIMESTAMP)
+        return;
+
+    if (st->last_timestamp == INVALID_TIMESTAMP)
+    {
+        st->last_timestamp = timestamp;
+        return;
+    }
+
+    int64_t delta = wrapped_delta(timestamp, st->last_timestamp);
+    st->last_timestamp = timestamp;
+    // Accept plausible video intervals only. A backward timestamp or a stream
+    // restart re-arms sampling instead of creating a huge false drop count.
+    if (delta <= 0 || delta > 90LL * 90000)
+    {
+        reset_timing(st);
+        st->last_timestamp = timestamp;
+        return;
+    }
+
+    if (st->nominal_interval <= 0)
+    {
+        // 1..240 fps. Values outside this range are not useful frame cadence.
+        if (delta >= 375 && delta <= 90000)
+            remember_clean_interval(st, delta);
+        return;
+    }
+
+    int64_t frames_advanced = (delta + st->nominal_interval / 2) / st->nominal_interval;
+    if (frames_advanced > 1)
+        st->estimated_drops += (uint64_t)(frames_advanced - 1);
+
+    // Continuously adapt to an encoder frame-rate change, but never teach the
+    // estimator with a loss gap itself.
+    if (frames_advanced == 1 && delta * 4 >= st->nominal_interval * 3 &&
+        delta * 4 <= st->nominal_interval * 5)
+        remember_clean_interval(st, delta);
+}
+
+void parse_video_pes(const uint8_t *payload, int len, ts_frame_stats_state *st)
+{
+    int64_t timestamp = INVALID_TIMESTAMP;
+    if (len >= 9 && payload[0] == 0x00 && payload[1] == 0x00 && payload[2] == 0x01 &&
+        payload[3] >= 0xE0 && payload[3] <= 0xEF)
+    {
+        int flags = payload[7] & 0xC0;
+        int header_len = payload[8];
+        if (9 + header_len <= len)
+        {
+            if (flags == 0xC0 && header_len >= 10)
+                timestamp = read_pts(payload + 14); // DTS is monotonic with B-frames
+            else if (flags == 0x80 && header_len >= 5)
+                timestamp = read_pts(payload + 9);
+        }
+    }
+    note_frame(st, timestamp);
+}
+} // namespace
+
+void sls_init_ts_frame_stats(ts_frame_stats_state *st)
+{
+    if (st == nullptr)
+        return;
+    std::memset(st, 0, sizeof(*st));
+    st->pmt_pid = INVALID_TS_PID;
+    st->video_pid = INVALID_TS_PID;
+    st->codec = SLS_TC_CODEC_NONE;
+    st->last_timestamp = INVALID_TIMESTAMP;
+}
+
+void sls_ts_scan_frame_stats(const uint8_t *data, int len, ts_frame_stats_state *st)
+{
+    if (data == nullptr || st == nullptr)
+        return;
+
+    for (int offset = 0; offset + TS_PACKET_LENGTH <= len; offset += TS_PACKET_LENGTH)
+    {
+        const uint8_t *packet = data + offset;
+        if (packet[0] != TS_SYNC || (packet[1] & 0x80) != 0)
+            continue;
+        int pid = ((packet[1] & 0x1F) << 8) | packet[2];
+        int afc = (packet[3] >> 4) & 0x3;
+        if ((afc & 0x1) == 0)
+            continue;
+        int pos = 4;
+        if ((afc & 0x2) != 0)
+        {
+            pos += 1 + packet[4];
+            if (pos >= TS_PACKET_LENGTH)
+                continue;
+        }
+        const uint8_t *payload = packet + pos;
+        int payload_len = TS_PACKET_LENGTH - pos;
+        bool pusi = (packet[1] & 0x40) != 0;
+        if (!pusi)
+            continue;
+        if (pid == PAT_PID)
+            parse_pat(payload, payload_len, st);
+        else if (pid == st->pmt_pid)
+            parse_pmt(payload, payload_len, st);
+        else if (pid == st->video_pid && st->codec != SLS_TC_CODEC_NONE)
+            parse_video_pes(payload, payload_len, st);
+    }
+}
+
+ts_frame_stats_snapshot sls_get_ts_frame_stats(const ts_frame_stats_state *st)
+{
+    ts_frame_stats_snapshot snapshot;
+    if (st == nullptr)
+        return snapshot;
+    snapshot.valid = st->video_pid != INVALID_TS_PID && st->nominal_interval > 0;
+    snapshot.codec = st->codec;
+    snapshot.video_pid = st->video_pid;
+    snapshot.observed_frames = st->observed_frames;
+    snapshot.estimated_drops = st->estimated_drops;
+    snapshot.nominal_interval = st->nominal_interval;
+    return snapshot;
+}
diff --git a/src/core/SLSFrameStats.hpp b/src/core/SLSFrameStats.hpp
new file mode 100644
index 0000000..7513968
--- /dev/null
+++ b/src/core/SLSFrameStats.hpp
@@ -0,0 +1,42 @@
+/**
+ * The MIT License (MIT)
+ *
+ * Copyright (c) 2019-2020 Edward.Wu
+ */
+
+#pragma once
+
+#include <cstdint>
+
+// Lightweight MPEG-TS video timing monitor. It does not decode video and never
+// changes relayed bytes. It learns the first H.264/HEVC PID from PAT/PMT, counts
+// access units and estimates missing access units from DTS/PTS gaps.
+struct ts_frame_stats_state
+{
+    int pmt_pid;
+    int video_pid;
+    int codec;
+
+    int64_t last_timestamp;
+    int64_t frame_intervals[24];
+    int interval_count;
+    int interval_index;
+    int64_t nominal_interval;
+
+    uint64_t observed_frames;
+    uint64_t estimated_drops;
+};
+
+struct ts_frame_stats_snapshot
+{
+    bool valid = false;
+    int codec = 0;
+    int video_pid = -1;
+    uint64_t observed_frames = 0;
+    uint64_t estimated_drops = 0;
+    int64_t nominal_interval = 0; // 90 kHz MPEG clock ticks
+};
+
+void sls_init_ts_frame_stats(ts_frame_stats_state *st);
+void sls_ts_scan_frame_stats(const uint8_t *data, int len, ts_frame_stats_state *st);
+ts_frame_stats_snapshot sls_get_ts_frame_stats(const ts_frame_stats_state *st);
