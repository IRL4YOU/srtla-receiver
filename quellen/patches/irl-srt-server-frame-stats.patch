@@ -0,0 +1,135 @@
+#include "doctest.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+#include "SLSFrameStats.hpp"
+
+namespace
+{
+constexpr int PMT_PID = 0x1000;
+constexpr int VIDEO_PID = 0x0100;
+constexpr int TS_PACKET_LENGTH = 188;
+constexpr int PAT_PID = 0;
+
+void finish_section(std::vector<uint8_t> &section)
+{
+    size_t body = section.size() - 3 + 4;
+    section[1] = (uint8_t)(0xB0 | ((body >> 8) & 0x0F));
+    section[2] = (uint8_t)(body & 0xFF);
+    section.insert(section.end(), {0xDE, 0xAD, 0xBE, 0xEF});
+}
+
+std::vector<uint8_t> psi_packet(int pid, std::vector<uint8_t> section)
+{
+    std::vector<uint8_t> packet = {0x47, (uint8_t)(0x40 | ((pid >> 8) & 0x1F)),
+                                   (uint8_t)(pid & 0xFF), 0x10, 0x00};
+    packet.insert(packet.end(), section.begin(), section.end());
+    packet.resize(TS_PACKET_LENGTH, 0xFF);
+    return packet;
+}
+
+std::vector<uint8_t> pat_packet()
+{
+    std::vector<uint8_t> section = {0x00, 0x00, 0x00, 0x00, 0x01, 0xC1, 0x00, 0x00,
+                                    0x00, 0x01, (uint8_t)(0xE0 | (PMT_PID >> 8)),
+                                    (uint8_t)(PMT_PID & 0xFF)};
+    finish_section(section);
+    return psi_packet(PAT_PID, section);
+}
+
+std::vector<uint8_t> pmt_packet()
+{
+    std::vector<uint8_t> section = {0x02, 0x00, 0x00, 0x00, 0x01, 0xC1, 0x00, 0x00,
+                                    0xE0, 0x00, 0xF0, 0x00,
+                                    0x24, (uint8_t)(0xE0 | (VIDEO_PID >> 8)),
+                                    (uint8_t)(VIDEO_PID & 0xFF), 0xF0, 0x00};
+    finish_section(section);
+    return psi_packet(PMT_PID, section);
+}
+
+void append_pts(std::vector<uint8_t> &out, int64_t pts, uint8_t prefix)
+{
+    out.push_back((uint8_t)(prefix | (((pts >> 30) & 0x07) << 1)));
+    out.push_back((uint8_t)((pts >> 22) & 0xFF));
+    out.push_back((uint8_t)(0x01 | (((pts >> 15) & 0x7F) << 1)));
+    out.push_back((uint8_t)((pts >> 7) & 0xFF));
+    out.push_back((uint8_t)(0x01 | ((pts & 0x7F) << 1)));
+}
+
+std::vector<uint8_t> video_packet(int64_t dts, uint8_t cc)
+{
+    std::vector<uint8_t> packet = {0x47, (uint8_t)(0x40 | (VIDEO_PID >> 8)),
+                                   (uint8_t)(VIDEO_PID & 0xFF), (uint8_t)(0x10 | (cc & 0x0F))};
+    std::vector<uint8_t> pes = {0x00, 0x00, 0x01, 0xE0, 0x00, 0x00, 0x80, 0xC0, 0x0A};
+    append_pts(pes, dts, 0x31); // PTS
+    append_pts(pes, dts, 0x11); // DTS
+    pes.push_back(0x00);
+    packet.insert(packet.end(), pes.begin(), pes.end());
+    packet.resize(TS_PACKET_LENGTH, 0xFF);
+    return packet;
+}
+
+void append(std::vector<uint8_t> &out, const std::vector<uint8_t> &part)
+{
+    out.insert(out.end(), part.begin(), part.end());
+}
+} // namespace
+
+TEST_CASE("frame stats: stable cadence reports no estimated drops")
+{
+    ts_frame_stats_state state;
+    sls_init_ts_frame_stats(&state);
+    std::vector<uint8_t> ts;
+    append(ts, pat_packet());
+    append(ts, pmt_packet());
+    for (int frame = 0; frame < 20; frame++)
+        append(ts, video_packet(90000 + frame * 3000, (uint8_t)frame));
+
+    sls_ts_scan_frame_stats(ts.data(), (int)ts.size(), &state);
+    ts_frame_stats_snapshot stats = sls_get_ts_frame_stats(&state);
+    CHECK(stats.valid);
+    CHECK(stats.observed_frames == 20);
+    CHECK(stats.nominal_interval == 3000);
+    CHECK(stats.estimated_drops == 0);
+}
+
+TEST_CASE("frame stats: a DTS gap is counted as missing video frames")
+{
+    ts_frame_stats_state state;
+    sls_init_ts_frame_stats(&state);
+    std::vector<uint8_t> ts;
+    append(ts, pat_packet());
+    append(ts, pmt_packet());
+    uint8_t cc = 0;
+    int64_t dts = 90000;
+    for (int frame = 0; frame < 12; frame++, dts += 3000)
+        append(ts, video_packet(dts, cc++));
+    dts += 6000; // skip two 3000-tick frame positions
+    append(ts, video_packet(dts, cc++));
+
+    sls_ts_scan_frame_stats(ts.data(), (int)ts.size(), &state);
+    ts_frame_stats_snapshot stats = sls_get_ts_frame_stats(&state);
+    CHECK(stats.valid);
+    CHECK(stats.nominal_interval == 3000);
+    CHECK(stats.estimated_drops == 2);
+}
+
+TEST_CASE("frame stats: MPEG clock wrap does not create a false drop")
+{
+    ts_frame_stats_state state;
+    sls_init_ts_frame_stats(&state);
+    std::vector<uint8_t> ts;
+    append(ts, pat_packet());
+    append(ts, pmt_packet());
+    const int64_t wrap = 1LL << 33;
+    int64_t start = wrap - 27000;
+    for (int frame = 0; frame < 20; frame++)
+        append(ts, video_packet((start + frame * 3000) % wrap, (uint8_t)frame));
+
+    sls_ts_scan_frame_stats(ts.data(), (int)ts.size(), &state);
+    ts_frame_stats_snapshot stats = sls_get_ts_frame_stats(&state);
+    CHECK(stats.valid);
+    CHECK(stats.estimated_drops == 0);
+}
